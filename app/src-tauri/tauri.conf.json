{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trimwire Flightdeck",
  "version": "0.1.0",
  "identifier": "dev.trimwire.flightdeck",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "trimwire · Flightdeck",
        "width": 980,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "url": "http://127.0.0.1:8766"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
