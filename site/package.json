{
  "name": "trimwire-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "trimwire's public site: landing page, docs, community telemetry dashboard, and performance page (Astro + Starlight).",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "gen-og": "node scripts/gen-og.mjs",
    "predev": "npm run sync-docs",
    "dev": "astro dev",
    "prebuild": "npm run sync-docs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "linkcheck": "linkinator ./dist --recurse --skip \"^https?://(?!localhost)\"",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.6",
    "sharp": "^0.35.3",
    "starlight-llms-txt": "^0.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "happy-dom": "^20.11.1",
    "linkinator": "^8.0.3",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
