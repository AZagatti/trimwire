# Build-time public config for the Astro docs site (committed: these are public
# URLs, not secrets). Astro exposes PUBLIC_* vars to the client; the dashboard +
# benchmark widgets read them and fetch the feed client-side at runtime.

# Live telemetry collector (the Cloudflare Worker in collector/, at api.trimwire.dev).
# The community dashboard fetches this; it shows an honest empty-state until a
# cohort crosses the k-anonymity threshold (k=10).
PUBLIC_AGGREGATES_URL=https://api.trimwire.dev/aggregates.json

# Live benchmark leaderboard feed (collector route GET /benchmarks.json). The
# benchmark widget fetches this and shows an honest empty-state until a model
# group crosses the benchmark k-anonymity threshold (k=5).
PUBLIC_BENCHMARK_URL=https://api.trimwire.dev/benchmarks.json
