# starlight-llms-txt@0.10.0 still declares `astro ^6` as a peer, but it works
# fine on Astro 7 (it's a build-time Starlight plugin, not a runtime astro API
# consumer). Until upstream widens the peer range, allow the install to proceed
# rather than hard-failing on the stale peer declaration. Applies to both local
# `npm install` and CI `npm ci`.
legacy-peer-deps=true
