---
/**
 * Production landing (`/`) — terminal-first hero (dark-only).
 * This static route wins over Starlight's `[...slug]` catch-all (a concrete
 * page is more specific), so there's no duplicate-route error. Starlight still
 * owns every /guides/* doc and the markdown sync is untouched.
 *
 * The Claude Code pane is a pristine real transcript; ALL Trimwire shaping lives
 * in the daemon, linked by sync flashes + hover — no fake markers in the
 * transcript. Multi-turn session; the native Claude Code statusline (model ·
 * context bar · % · tokens · accept-edits) is bound to the left pane. The
 * context bar tracks context-window USAGE: it climbs as the session grows and
 * drops when Trimwire prunes/summarizes. One interactive below-fold inspector.
 * Research-calibrated motion/a11y.
 *
 * Tailwind v4 (utilities, no preflight, page-scoped — Starlight untouched).
 * Naming/format/numbers are product-accurate (strategies/mod.rs, gateway.rs, docs/*).
 */
import "../styles/hero-shared.css";
import "../styles/tailwind.css";
import TerminalProof from "../components/landing/TerminalProof.svelte";
import ModeInspector from "../components/landing/ModeInspector.svelte";
const REPO = "https://github.com/AZagatti/trimwire";
const sec = "mx-auto max-w-[58rem] px-[clamp(1rem,4vw,2.5rem)]";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>trimwire — prune your coding agent's context on every request</title>
    <meta name="description" content="A tiny local gateway that prunes your coding agent's context on every request — watch a real Claude Code session run beside the live Trimwire gateway." />
  </head>
  <body>
    <header class="vx-header">
      <a class="vx-brand" href="/"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="5" fill="#2aa39c"/><rect x="5.5" y="7" width="13" height="2" rx="1" fill="#fff"/><rect x="11" y="7" width="2" height="11" rx="1" fill="#fff"/></svg><span>trimwire</span></a>
      <nav class="vx-nav"><a href="/guides/overview/">docs</a><a href="/performance/">results</a><a href={REPO} target="_blank" rel="noopener noreferrer">GitHub</a></nav>
    </header>

    <main class="w-full [overflow-x:clip]">
      <!-- ── HERO (terminal-first) ────────────────────────────────────────── -->
      <section class={`${sec} pt-[clamp(1.4rem,4vmin,2.6rem)] pb-[clamp(1.4rem,4vmin,2.4rem)]`}>
        <a class="release-pill" href={REPO + "/releases"} target="_blank" rel="noopener noreferrer">signed, verifiable releases <span aria-hidden="true">→</span></a>
        <h1 class="m-0 mt-[0.9rem] font-mono font-[640] tracking-[-0.03em] leading-[1.05] text-balance text-[clamp(1.8rem,4.8vw,2.9rem)]">Stop re-sending <span class="text-accenthi">stale context</span> every turn.</h1>
        <p class="mt-[0.7rem] mb-0 text-ink2 max-w-[60ch] text-[clamp(0.96rem,1.4vw,1.08rem)]">Long agent sessions pile up old tool output and repeated reads. Trimwire is a tiny local gateway that removes what no longer helps before the next request — and your session transcript stays intact.</p>
      </section>

      <section class="mx-auto px-[clamp(0.75rem,3vw,2.5rem)]">
        <div class="term-wide"><TerminalProof client:visible /></div>
      </section>

      <!-- ── Below-fold: one interactive inspector ────────────────────────── -->
      <section class={`${sec} mt-[clamp(2.2rem,6vmin,4rem)] pt-[clamp(1.8rem,5vmin,3rem)] border-t border-border`}>
        <ModeInspector client:visible />
      </section>
    </main>

    <footer class="vx-footer !mt-[clamp(2.2rem,6vmin,3.6rem)]">
      <span>MIT OR Apache-2.0</span> · <a href="/performance/">results</a> · <a href={REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>

    <style>
      .release-pill { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--mono); font-size: 0.72rem; color: var(--accent-hi); background: var(--accent-soft); border: 1px solid var(--border-2); border-radius: 999px; padding: 0.25rem 0.7rem; text-decoration: none; transition: border-color 0.15s; }
      .release-pill:hover { border-color: var(--accent); }

      /* terminal is the only wide element (Superset/Conductor canvas) */
      .term-wide { width: min(86rem, 96vw); margin-inline: auto; }
      /* mobile: the terminal window itself pans (overflow-x on .termwin), so the
         wrapper must NOT add a second scroller or an edge mask — the mask faded
         the window border + text mid-read. Just let it be full-width. */
      @media (max-width: 52rem) {
        .term-wide { width: 100%; max-width: 100%; }
      }

      .vx-footer a { color: var(--ink-2); } .vx-footer a:hover { color: var(--accent-hi); }
    </style>
  </body>
</html>
