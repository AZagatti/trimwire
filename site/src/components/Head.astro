---
/**
 * Custom Head override — extends Starlight's default head output with a small
 * accessibility fix: scrollable <pre> code blocks and wide <table>s must be
 * keyboard-focusable (axe rule: scrollable-region-focusable). Starlight styles
 * overflowing tables as their own scroll container, so a wide reference table
 * (e.g. /guides/model-compatibility/, /guides/telemetry/) is mouse-scrollable
 * but unreachable by keyboard. We add tabindex="0" to any such element whose
 * scrollable width exceeds its client width, making them keyboard-reachable.
 *
 * All other <head> tags come from Starlight's own head array (canonical, meta,
 * favicons, etc.) — we do not duplicate them here.
 */
const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script is:inline>
  /**
   * For every <pre> or <table> that is scrollable (scrollWidth > clientWidth),
   * add tabindex="0" so keyboard users can reach and scroll it.
   * Runs after paint so the layout is stable (scrollWidth is reliable).
   */
  (function () {
    function patchScrollable() {
      var els = document.querySelectorAll("pre, table");
      for (var i = 0; i < els.length; i++) {
        var el = els[i];
        if (el.scrollWidth > el.clientWidth && el.getAttribute("tabindex") === null) {
          el.setAttribute("tabindex", "0");
        }
      }
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", patchScrollable);
    } else {
      patchScrollable();
    }
  })();
</script>
