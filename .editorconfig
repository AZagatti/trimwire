# https://editorconfig.org — consistent formatting across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false  # two trailing spaces = a hard line break

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.{ts,mjs,js,astro,mdx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab
